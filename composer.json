{
    "name": "simtabi/lacommerce",
    "description": "A collection handy helper functions for your laravel ecommerce projects",
    "keywords": [
        "simtabi",
        "eloquent",
        "laravel",
        "sku"
    ],
    "homepage": "https://opensource.simtabi.com/products/simtabi/lacommerce",
    "support": {
        "issues": "https://github.com/simtabi/lacommerce/issues",
        "source": "https://github.com/simtabi/lacommerce",
        "docs": "https://opensource.simtabi.com/documentation/simtabi/lacommerce/"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Imani Manyara",
            "email": "imani@simtabi.com",
            "homepage": "https://github.com/simtabi",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4.1 || ^8.5",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.6 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Simtabi\\Lacommerce\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Simtabi\\Lacommerce\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Simtabi\\Lacommerce\\Providers\\LacommerceServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
